{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // Edge Function entry points run on Deno (npm: imports, Deno globals); their logic lives in
  // handler.ts files, which stay type-checked here and tested with Jest.
  "exclude": ["node_modules", "supabase/functions/*/index.ts"]
}
